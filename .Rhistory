region == 5 ~ "West Midlands",
region == 6 ~ "East of England",
region == 7 ~ "London",
region == 8 ~ "South East",
region == 9 ~ "South West",
region == 10 ~ "Wales",
region == 11 ~ "Scotland",
region == 12 ~ "Northern Ireland",
TRUE ~ NA))
